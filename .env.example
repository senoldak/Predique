# ==============================================================================
# Predique Configuration Template
# Copy this file to .env and customize for your environment.
# NEVER commit .env with real credentials to source control.
# ==============================================================================

# --- Server & Web Configuration ---
PORT=3001
WEB_APP_URL=http://localhost:3000

# --- Telegram Bot Configuration ---
# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here
# Target Channel Username or ID for alpha signal broadcasts (e.g., @predique or -1001234567890)
TELEGRAM_CHANNEL_ID=@predique
# Comma-separated list of numeric Telegram User IDs authorized for admin commands (e.g., /autotrade on|off)
# Empty = mutating admin commands blocked for everyone (fail-closed)
TELEGRAM_ADMIN_IDS=123456789

# --- Database & In-Memory State ---
# Redis URL for sub-second market state, mutexes, rate limiting, and order idempotency
REDIS_URL=redis://localhost:6379
# PostgreSQL Connection URL (for persistent user portfolios and audit history)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/predique?schema=public

# --- Cryptographic Security & Keystore ---
# 256-bit Hex Master Key for AES-256-GCM Wallet Encryption (Generate with: openssl rand -hex 32)
# Refused automatically when NODE_ENV=production if the placeholder key is used.
PREDIQUE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Key Rotation: Set PREVIOUS to the retired key, PRIMARY to the new key, and restart.
# Existing keystores decrypt via fallback; new writes use PRIMARY. Once re-encrypted, unset PREVIOUS.
PREDIQUE_MASTER_KEY_PREVIOUS=

# --- Authentication & Access Control ---
# JWT Secret for Web Terminal session tokens (Generate with: openssl rand -base64 48; min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
# Demo login (bypasses Telegram login verification; set true ONLY for local development)
ALLOW_DEMO_AUTH=false
# Comma-separated list of allowed CORS origins (no '*' wildcard in production)
CORS_ORIGINS=http://localhost:3000
# Admin operations token for runtime configuration updates via API (min 32 chars)
ADMIN_TOKEN=change-me-to-a-long-random-admin-token-min-32

# --- Trading & Execution Controls ---
# Live on-chain execution kill-switch. Defaults to false (Paper trading mode enforced)
ALLOW_LIVE_TRADING=false

# --- Multi-Chain RPC Providers (Optional / Fallback to public endpoints) ---
BASE_RPC_URL=https://mainnet.base.org
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ETH_RPC_URL=https://eth.llamarpc.com
BNB_RPC_URL=https://binance.llamarpc.com
ROBINHOOD_RPC_URL=https://robinhoodchain.blockscout.com
